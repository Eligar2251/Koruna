{
  "name": "koruna",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Сайт ЦСБ на Next.js: витрина, админка и каталог",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "strip": "node scripts/strip-site.mjs",
    "clean": "node scripts/clean-db.mjs",
    "clean:dry": "node scripts/clean-db.mjs --dry-run",
    "test": "node --test scripts/test-clean.mjs scripts/test-catalog.mjs scripts/test-accounts.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "next": "^15.5.28",
    "pg": "^8.16.3",
