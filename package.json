{
  "name": "koruna",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Сайт ЦСБ на Next.js: витрина, админка и каталог",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "strip": "node scripts/strip-site.mjs",
    "clean": "node scripts/clean-db.mjs",
    "clean:dry": "node scripts/clean-db.mjs --dry-run",
    "test": "node --test scripts/test-clean.mjs scripts/test-catalog.mjs scripts/test-accounts.mjs scripts/test-config-layout.mjs scripts/test-inventory.mjs scripts/test-site-operations.mjs scripts/test-navigation.mjs scripts/test-intake-security.mjs scripts/test-admin-setup.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "admin:setup": "node scripts/setup-admin-entry.mjs",
    "admin:check": "node scripts/setup-admin-entry.mjs --check",
    "admin:rotate": "node scripts/setup-admin-entry.mjs --rotate-path --rotate-secret"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "next": "^15.5.28",
    "nodemailer": "^10.1.2",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.30"
  }
}
