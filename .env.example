# Скопируйте в .env и подставьте значения своего проекта.
# Файл .env в git не попадает.

# Пароль входа в /admin. Без него админка не пускает.
ADMIN_PASSWORD=choose-a-long-password

# Project Settings → Database → Connection string → URI.
# Direct connection или Session pooler, порт 5432.
# Порт 6543 (transaction pooler) не подходит: скрипт выполняет DDL.
# Если в пароле есть спецсимволы, закодируйте их (например @ → %40).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Project Settings → API. Нужны, чтобы удалить файлы Storage, а не только строки в Postgres.
# service_role / secret обходит RLS. Не используйте anon и не коммитьте ключ.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
