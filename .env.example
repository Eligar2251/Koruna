# Скопируйте в .env и подставьте значения своего проекта.
# Файл .env в git не попадает.
# Сайт не использует строку подключения к Postgres и не использует service role.

# Project Settings → API. Пока ключей нет, каталог и админы хранятся в data/.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Локальный админ, если Supabase не задан. Пароль в базе лежит односторонним JWT-ключом.
ADMIN_EMAIL=admin@csb.local
ADMIN_PASSWORD=replace-me
JWT_SECRET=replace-with-a-long-random-string
