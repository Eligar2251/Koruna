# Скопируйте в .env и подставьте значения своего проекта.
# Файл .env в git не попадает.
# Сайт не использует строку подключения к Postgres и не использует service role.

# Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Пароль администратора задаётся в Supabase Authentication, не в этом файле.
# Сайт получает только JWT и держит его в HttpOnly-куке.
