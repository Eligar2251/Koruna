SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Закрытая панель: заполните эти два поля сами. Команды admin:setup/admin:rotate НЕ нужны.
# После редактирования перезапустите сайт; для одной только смены env пересборка не нужна.
# Путь: / + 16–128 латинских букв, цифр, _ или -. Не полный URL, не /admin.
# Выберите собственный длинный непредсказуемый путь; не используйте опубликованные примеры.
ADMIN_PATH=
# Новый непредсказуемый секрет минимум 32 символа (рекомендуется 48–64 случайных символа).
# Не пароль администратора и не готовый JWT-токен. Не используйте ранее опубликованный ключ.
JWT_SECRET=
# Не добавляйте префикс NEXT_PUBLIC_: эти значения должны оставаться только на сервере.
# Не дублируйте их в .env.local/.env.production.local или переменных хостинга:
# такие значения имеют приоритет над .env по стандартным правилам Next.js.

# Почтовый сервер российского провайдера. Пароль приложения, не основной пароль.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-mailbox@example.ru
# SMTP_PASSWORD=your-application-password
# MAIL_FROM=your-mailbox@example.ru
# REQUESTS_EMAIL=orders@example.ru
