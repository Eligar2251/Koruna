SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Генерируются командой npm run admin:setup. Проверка: npm run admin:check.
# ADMIN_PATH: один путь / + 16–128 URL-safe символов, не полный адрес сайта.
# JWT_SECRET: минимум 32 символа. Не используйте значения-примеры как секреты.
# ADMIN_PATH=/REPLACE_WITH_AT_LEAST_32_RANDOM_URL_SAFE_CHARACTERS
# JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_SECRET_CHARACTERS

# Почтовый сервер российского провайдера. Пароль приложения, не основной пароль.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-mailbox@example.ru
# SMTP_PASSWORD=your-application-password
# MAIL_FROM=your-mailbox@example.ru
# REQUESTS_EMAIL=orders@example.ru
