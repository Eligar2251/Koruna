# Скопируйте в .env. Значения ключей не коммитьте и не отправляйте в чат.
# Подключение сайта: Supabase → Project Settings → API.
# Используйте anon / publishable key, НЕ service_role / secret.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Необязательно, только для ручного удаления файлов Storage скриптом очистки.
# Для каталога, заказов и входа в админку этот ключ НЕ нужен.
# Не подставляйте его в SUPABASE_ANON_KEY или NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
